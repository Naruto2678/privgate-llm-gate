# Copy this file to ".env" and fill in ONE of the three setups below. NEVER commit .env to GitHub.
# Delete the "#" at the start of the lines you use. No quotes, no spaces around "=".

# ---- SETUP A: Google Gemini key from aistudio.google.com/apikey (free; keys start with AQ. or AIza) ----
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=paste-your-gemini-key-here
# LLM_MODEL=gemini-2.5-flash

# ---- SETUP B: OpenAI key (starts with sk-; needs billing credit) ----
# OPENAI_API_KEY=sk-paste-your-key-here

# ---- SETUP C: Ollama on your own PC (no key needed) ----
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
